<ul id="players" class="mt-2">
  <% players.each do |player| %>
    <li class="flex items-center gap-3 p-2 border-b pb-3 first:border-t">
      <div class="text-lg flex-1 flex items-center gap-2">
        <%= player.name %>
        <% if room.host == player %>
          <span class="text-xs bg-zinc-200 text-zinc-700 px-1 rounded">Host</span>
        <% end %>
      </div>
      <div class="text-2xl font-bold">
        <% if room.revealed? %>
          <span class="player-#{player.id}-vote"><%= player.votes.last&.value %></span>
        <% else %>
          <% if player.votes.last %>
            <span>✔</span>
          <% else %>
          <span>...</span>
          <% end %>
        <% end %>
      </div>
    </li>
  <% end %>
</ul>
