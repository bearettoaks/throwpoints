<header class="flex flex-col justify-center items-center p-2">
  <h1 class="text-xl">Room #</h1>
  <div class="text-2xl font-bold" aria-label="The rooms unique code">
    <%= @room.code %>
  </div>

  <div class="mt-4">
    <%= link_to "Join Room", join_room_path(@room.code), class: "underline" %>
  </div>
</header>

<hr/>
<br/>
<section class="flex flex-col justify-center items-center p-2">
  <div class="max-w-md mx-auto text-left w-1/3">
    <h2 class="text-xl text-center font-bold">Players</h2>
    <ul class="mt-2">
      <% @room.players.each do |player| %>
        <li class="flex items-center gap-3 p-2">
          <div class="text-lg flex-1 flex items-center gap-2">
            <%= player.name %>
            <% if @room.host == player %>
              <span class="text-xs bg-zinc-200 text-zinc-700 px-1 rounded">Host</span>
            <% end %>
          </div>
          <div class="text-2xl font-bold">
            <span>0</span>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
</section>
