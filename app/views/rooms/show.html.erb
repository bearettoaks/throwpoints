<%= turbo_stream_from @room %>

<header class="flex flex-col justify-center items-center p-2">
  <h1 class="text-xl">Room #</h1>
  <div class="room-code text-2xl font-bold" aria-label="The rooms unique code">
    <%= @room.code %>
  </div>

  <div class="mt-4">
    <div class="flex gap-2 items-center">
      <%= link_to "#{join_room_url(@room.code)}", join_room_path(@room.code), class: "underline" %>
      <button type="button" class="copy-to-clipboard" data-controller="clipboard" data-clipboard-text="<%= join_room_url(@room.code) %>">
        <svg class="copy-to-clipboard size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184" />
        </svg>
      </button>
    </div>
  </div>
</header>

<%= turbo_frame_tag "votes" do %>
  <%= render partial: "vote_buttons", locals: { room: @room } %>
<% end %>

<section class="flex flex-col justify-center items-center p-2 mt-8 mb-12">
  <div class="max-w-xl mx-auto text-left w-1/2">
    <%= turbo_frame_tag "players" do %>
      <%= render partial: "players", locals: { room: @room, players: @room.players } %>
    <% end %>
  </div>
</section>

<section class="flex gap-3 justify-center items-center p-2 mt-8">
  <%= button_to "Reset Votes", reset_votes_room_path(@room.code), method: :post, class: "reset-button btn btn-secondary" %>
  <%= button_to "Reveal Votes", reveal_room_path(@room.code), method: :post, class: "reveal-button btn btn-primary" %>
</section>
