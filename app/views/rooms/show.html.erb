 <%= turbo_stream_from @room %>

<header class="flex flex-col justify-center items-center p-2">
  <h1 class="text-xl">Room #</h1>
  <div class="text-2xl font-bold" aria-label="The rooms unique code">
    <%= @room.code %>
  </div>

  <div class="mt-4">
    <%= link_to "Join Room", join_room_path(@room.code), class: "underline" %>
  </div>
</header>

<%= turbo_frame_tag "votes" do %>
  <%= render partial: "vote_buttons", locals: { room: @room } %>
<% end %>

<section class="flex flex-col justify-center items-center p-2 mt-8 mb-12">
  <div class="max-w-xl mx-auto text-left w-1/2">
    <%= turbo_frame_tag "players" do %>
      <%= render partial: "players", locals: { room: @room, players: @room.players } %>
    <% end %>
  </div>
</section>

<section class="flex gap-3 justify-center items-center p-2 mt-8">
  <%= button_to "Reset Votes", reset_votes_room_path(@room.code), method: :post, class: "btn btn-secondary" %>
  <%= button_to "Reveal Votes", reveal_room_path(@room.code), method: :post, class: "btn btn-primary" %>
</section>
