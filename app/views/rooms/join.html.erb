<div class="flex flex-col justify-center items-center h-screen w-screen">
  <header class="mb-3 text-center">
    <h1 class="text-2xl font-bold">Join Room</h1>
    <h2 class="text-xl">Room # <%= @room.code %></h2>
  </header>
  <div class="max-w-md mx-auto">
    <%= form_with model: @player, url: players_path(@room.code), local: true, data: { turbo: false } do |form| %>
      <%= form.hidden_field :room_id, value: @room.id %>
      <div class="my-3">
        <%= form.label :name, "Display name" %>
        <%= form.text_field :name, required: true, class: "w-full" %>
      </div>
      <div>
        <%= form.submit "Join Room", class: "btn btn-primary w-full" %>
      </div>
    <% end %>
</div>
